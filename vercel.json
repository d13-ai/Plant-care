{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/((?!tag$|api/).*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/tag",
      "destination": "/api/tag"
    },
    {
      "source": "/plant/:id/edit",
      "destination": "/plant/_id/edit"
    },
    {
      "source": "/plant/:id",
      "destination": "/plant/_id"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
