# Where the web app is served, and so where a published tag's link points.
# Unset, the app falls back to the Vercel address built into src/lib/supabase.ts.
#
# This is inlined into the bundle at build time, not read at runtime, so a
# change needs a rebuild -- and on a phone that means a new app binary, since
# tagUrl() runs on the device. Leave it commented until plantparlour.org
# actually resolves: a tag minted against a domain that isn't live yet is a
# dead link, and links already shared can't be rewritten.
# EXPO_PUBLIC_SITE_URL=https://plantparlour.org
