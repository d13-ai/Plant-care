# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
dist-pages/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files. `.env` is ignored too: it used to be committed, which
# meant the next secret added to it would have been committed as well.
# Real values live in .env.local; .env.example documents what goes in it.
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Supabase CLI scratch — a version-check stamp it writes on any invocation,
# including `npx supabase --version`. Machine state, not project state.
supabase/.temp/
